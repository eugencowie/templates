{
  "private": true,
  "type": "module",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^26.8.1",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "^12.3.4",
      "onFail": "download"
    }
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint .",
    "lint:fix": "pnpm run lint --fix",
    "format": "prettier . --check",
    "format:fix": "pnpm run format --write",
    "test": "vitest run",
    "test:watch": "pnpm run test --watch",
    "validate": "pnpm run check && pnpm run lint && pnpm run format && pnpm run test",
    "validate:fix": "pnpm run lint:fix && pnpm run format:fix && pnpm run validate"
  },
  "dependencies": {
    "astro": "^7.3.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.3",
    "eslint": "10.10.0",
    "eslint-plugin-astro": "3.1.0",
    "jiti": "2.7.0",
    "prettier": "3.9.7",
    "prettier-plugin-astro": "1.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.1"
  }
}
